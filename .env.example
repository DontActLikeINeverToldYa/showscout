# Spotify (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify OAuth
SPOTIFY_REDIRECT_URI=http://localhost:8888/.netlify/functions/spotify-callback

# App base URL (used for OAuth redirect back into the SPA)
APP_BASE_URL=http://localhost:8888

# No Eventim API key needed — uses public endpoint
